# Copy this file to .env before local use.
# The app can run without an API key by using local rules and knowledge-base retrieval.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FLASK_SECRET_KEY=change-this-in-production
DATA_PATH=data/knowledge_base.xlsx

# Upload and batch parsing limits.
MAX_UPLOAD_MB=100
MAX_BATCH_FILES=50
MAX_TEXT_CHARS_PER_FILE=500000

# Optional access control: when set, /api/* requests must carry the
# X-Auth-Token header with this value. Leave empty for local no-login use.
AUTH_TOKEN=

# Optional limits: single image max size (MB) and PDF pages parsed per file.
MAX_IMAGE_MB=20
PDF_MAX_PAGES=60
